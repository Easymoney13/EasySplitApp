# Required for server-side receipt OCR. Without this key EasySplit can only
# offer the guarded local fallback, which intentionally rejects uncertain text.
GEMINI_API_KEY=replace-with-a-google-gemini-api-key
# Keep the primary model pinned; verification uses the other pinned model.
GEMINI_MODEL=gemini-2.0-flash

# Firebase Client Configuration (public web & mobile client credentials)
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=easysplit-24576.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=easysplit-24576
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=easysplit-24576.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=510350845002
NEXT_PUBLIC_FIREBASE_APP_ID=1:510350845002:web:cc49a335ab30154bbcb2b3
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-WFV5CP6F4Q

# Configure these on the EasySplit server to stream pseudonymized product events.
EASYSPLIT_ANALYTICS_URL=https://easysplit-founders-dashboard.yoavjacoel.chatgpt.site/api/analytics/ingest
EASYSPLIT_ANALYTICS_SECRET=replace-with-the-dashboard-ingestion-secret
TRUST_PROXY_HOPS=1
EASYSPLIT_ANALYTICS_HASH_SALT=replace-with-a-long-random-value
# Used only to create non-reversible aliases for phone numbers in restaurant
# visit analytics. Never expose this value to the browser.
EASYSPLIT_IDENTITY_HMAC_SECRET=replace-with-a-separate-long-random-value
EASYSPLIT_IDENTITY_HMAC_KEY_VERSION=v1
EASYSPLIT_INVITE_HMAC_SECRET=replace-with-another-long-random-value
EASYSPLIT_RESTAURANT_ATTESTATION_SECRET=replace-with-a-restaurant-evidence-signing-secret
# New session codes and signed guest links expire after 24 hours by default.
# Existing members can still reopen by their opaque room ID and member token.
EASYSPLIT_SESSION_ADMISSION_TTL_MS=86400000

# Mobile Platform Foundation (set these for the native build, not the existing web deployment).
# Keep them unset on the current web deployment to preserve same-origin behavior.
# NEXT_PUBLIC_EASYSPLIT_API_ORIGIN=https://your-easysplit-backend.example
# NEXT_PUBLIC_EASYSPLIT_WEB_ORIGIN=https://your-public-easysplit-web.example
# NEXT_PUBLIC_EASYSPLIT_WS_ORIGIN=wss://your-realtime-origin.example
# Exact Capacitor WebView origins permitted by the EasySplit server (comma-separated).
# Capacitor defaults are capacitor://localhost on iOS and https://localhost on Android.
# EASYSPLIT_ALLOWED_MOBILE_ORIGINS=capacitor://localhost,https://localhost

# App Store account-deletion compliance for Sign in with Apple (server-only).
# Never commit the real .p8 key. For the native iOS app, the client ID is the bundle ID.
# EASYSPLIT_APPLE_TEAM_ID=YOUR_TEAM_ID
# EASYSPLIT_APPLE_KEY_ID=YOUR_SIGN_IN_WITH_APPLE_KEY_ID
# EASYSPLIT_APPLE_CLIENT_ID=com.easysplit.app  # optional override; native default is this bundle ID
# EASYSPLIT_APPLE_PRIVATE_KEY_PATH=/secure/path/AuthKey_KEYID.p8
# Alternatively inject the PEM text as EASYSPLIT_APPLE_PRIVATE_KEY in the server secret store.

# Google Play release signing (local/CI only; never expose these to the web bundle).
# EASYSPLIT_ANDROID_KEYSTORE_PATH=/secure/path/easysplit-upload.jks
# EASYSPLIT_ANDROID_KEYSTORE_PASSWORD=replace-in-secret-store
# EASYSPLIT_ANDROID_KEY_ALIAS=easysplit-upload
# EASYSPLIT_ANDROID_KEY_PASSWORD=replace-in-secret-store
