{
  "name": "billsplit",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.js",
    "test:strain": "node --test tests/strain.integration.js",
    "test:ocr-hebrew": "node --test tests/hebrew-ocr.integration.js",
    "verify:firestore": "node scripts/verify-firestore-parity.js",
    "cutover:firestore": "node scripts/safe-firestore-cutover.js",
    "verify": "npm run test && npm run test:ocr-hebrew && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "canvas-confetti": "^1.9.3",
    "express": "^4.19.2",
    "firebase": "^10.12.2",
    "firebase-admin": "^12.1.1",
    "lucide-react": "^0.400.0",
    "next": "^14.2.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3"
  }
}
