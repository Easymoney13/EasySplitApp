{
  "name": "billsplit",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node server.js",
    "postinstall": "node scripts/patch-capacitor-system-bars.mjs",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.js",
    "test:strain": "node --test tests/strain.integration.js",
    "test:ocr-hebrew": "node --test tests/hebrew-ocr.integration.js",
    "verify:firestore": "node scripts/verify-firestore-parity.js",
    "audit:restaurant-data": "node scripts/restaurant-data-foundation-dry-run.js",
    "backfill:restaurant-data": "node scripts/restaurant-data-backfill.js",
    "cutover:firestore": "node scripts/safe-firestore-cutover.js",
    "verify": "npm run test && npm run test:ocr-hebrew && npm run typecheck && npm run build",
    "mobile:check-node": "node scripts/check-mobile-node.mjs",
    "mobile:dev": "npm run mobile:check-node && vite --config vite.mobile.config.ts --mode mobile",
    "mobile:build": "npm run mobile:check-node && vite build --config vite.mobile.config.ts --mode mobile",
    "mobile:sync": "npm run mobile:build && cap sync",
    "mobile:open:ios": "npm run mobile:check-node && cap open ios",
    "mobile:open:android": "npm run mobile:check-node && cap open android",
    "verify:mobile-shell": "node --test tests/mobile-*.test.mjs && npm run mobile:build",
    "verify:mobile-release": "npm run verify:mobile-release-env && npm run mobile:build && node scripts/verify-mobile-release.mjs",
    "verify:mobile-release-env": "node scripts/verify-mobile-release-env.mjs",
    "verify:mobile-release-endpoints": "node scripts/verify-mobile-release-endpoints.mjs",
    "mobile:bundle:android": "npm run mobile:sync && cd android && ./gradlew :app:bundleRelease --no-daemon --stacktrace",
    "mobile:archive:ios": "bash scripts/archive-ios-release.sh",
    "test:release": "node --test tests/release-compliance.test.mjs tests/mobile-release-env.test.mjs tests/mobile-release-bundle-audit.test.mjs tests/ios-release-toolchain.test.mjs tests/apple-token-revocation.test.js"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "8.5.0",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@capawesome/capacitor-apple-sign-in": "0.1.3",
    "@capawesome/capacitor-google-sign-in": "0.1.3",
    "@google/generative-ai": "^0.21.0",
    "canvas-confetti": "^1.9.3",
    "express": "^4.19.2",
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0",
    "lucide-react": "^0.400.0",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "6.1.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "8.2.2"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    },
    "qs": "6.16.0",
    "teeny-request": {
      "uuid": "11.1.1"
    }
  }
}
